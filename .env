# ─── App ───────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME=CodeAssess

# ─── Backend (used by your Node/Express server, not Vite) ──────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (recommended — change user/password/dbname as needed)
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/codeassess_db"
# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# ─── Code Execution (Judge0 or self-hosted) ────────────────────────────────────
# If using Judge0 SaaS:
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
# If self-hosting Judge0 locally:
# JUDGE0_API_URL=http://localhost:2358

# ─── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
